# =============================================================
# terraform.tfvars.example
# =============================================================
# Copia este archivo como terraform.tfvars y rellena los valores.
# NUNCA subas terraform.tfvars al repositorio (está en .gitignore).
#
# Las credenciales AWS se obtienen de AWS Academy Sandbox:
#   Learner Lab → AWS Details → AWS CLI → Show
# =============================================================

# ----- Credenciales AWS Sandbox (cambian cada sesión ~3h) -----
aws_access_key    = "ASIAXXXXXXXXXXX"
aws_secret_key    = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
aws_session_token = "xxxxx...token largo...xxxxx"

# ----- Base de Datos -----
db_password = "tu_password_seguro_aqui"

# ----- Aplicación Laravel -----
# Obtener con: php artisan key:generate --show
app_key = "base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ----- Opcional -----
# redis_password = "redis_secret"
# instance_type  = "t3.small"
# ghcr_image     = "ghcr.io/serbrigue/veterinaria:main"
# mail_username  = "sbg.daemon@gmail.com"
# mail_password  = "xxxx xxxx xxxx xxxx"
